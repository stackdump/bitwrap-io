load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = [
        "auth.go",
        "bundle_v3.go",
        "deploy.go",
        "merkle.go",
        "metrics.go",
        "polls.go",
        "polls_v3.go",
        "polls_v3_aggregate.go",
        "pollstate.go",
        "ratelimit.go",
        "server.go",
        "tally_proof.go",
    ],
    importpath = "github.com/stackdump/bitwrap-io/internal/server",
    visibility = ["//:__subpackages__"],
    deps = [
        "//dsl",
        "//erc",
        "//internal/metamodel",
        "//internal/seal",
        "//internal/store",
        "//internal/svg",
        "//prover",
        "//solidity",
        "@com_github_consensys_gnark//frontend",
        "@com_github_consensys_gnark_crypto//ecc/bn254/twistededwards",
        "@org_golang_x_crypto//sha3",
    ],
)

go_test(
    name = "server_test",
    size = "enormous",  # keep: real Groth16 proving under the purego tag is slow (>5m default)
    srcs = [
        "devsign_test.go",
        "jsparity_test.go",
        "keys_endpoint_test.go",
        "polls_test.go",
        "polls_v3_aggregate_test.go",
        "polls_v3_close_poll_test.go",
        "polls_v3_gating_test.go",
        "polls_v3_test.go",
        "polls_v3_vote_test.go",
        "polls_v3_votes_endpoint_test.go",
        "registry_sig_test.go",
        "runtime_parity_test.go",
        "server_test.go",
        "sk_creator_store_jsparity_test.go",
        "tally_proof_test.go",
        "test_gen_contracts_test.go",
        "v3_disk_test.go",
        "v3_verifier_solidity_test.go",
    ],
    embed = [":server"],
    deps = [
        "//dsl",
        "//internal/metamodel",
        "//internal/store",
        "//prover",
        "//public",
        "//solidity",
        "@com_github_consensys_gnark//backend/groth16",
        "@com_github_consensys_gnark//frontend",
        "@com_github_consensys_gnark_crypto//ecc",
        "@com_github_consensys_gnark_crypto//ecc/bn254/twistededwards",
    ],
)
